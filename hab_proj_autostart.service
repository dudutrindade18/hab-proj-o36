[Unit]
Description=HAB Project AI Classification System
After=network.target

[Service]
Type=simple
User=hab-proj5
WorkingDirectory=/home/hab-proj5/Desktop/hab-proj-o36
Environment="PYTHONPATH=/home/hab-proj5/Desktop/hab-proj-o36"
Environment="PATH=/home/hab-proj5/Desktop/hab-proj-o36/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="DISPLAY=:0"
After=sound.target
ExecStart=/bin/bash -c 'source /home/hab-proj5/Desktop/hab-proj-o36/venv/bin/activate && python /home/hab-proj5/Desktop/hab-proj-o36/main.py --headless'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hab-proj

[Install]
WantedBy=multi-user.target 