[Unit]
Description=HAB Project AI Classification System
After=network.target

[Service]
Type=simple
User=hab-proj5
WorkingDirectory=/home/hab-proj5/Desktop/hab-proj-o36
Environment="PYTHONPATH=/home/hab-proj5/Desktop/hab-proj-o36"
Environment="PATH=/home/hab-proj5/Desktop/hab-proj-o36/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="DISPLAY=:0"
ExecStart=/usr/bin/lxterminal --working-directory=/home/hab-proj5/Desktop/hab-proj-o36 --command="/home/hab-proj5/Desktop/hab-proj-o36/venv/bin/python /home/hab-proj5/Desktop/hab-proj-o36/main.py --no-fps"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hab-proj

[Install]
WantedBy=multi-user.target 